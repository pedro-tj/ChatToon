# Local package from this repository:
#   cd packaging/arch && makepkg -si
# Remove: sudo pacman -R chattoon

pkgname=chattoon
pkgver=0.1.0
pkgrel=1
pkgdesc="3D avatar co-host for YouTube live streams, powered by local AI (Ollama) and TTS BigLinux"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'python-aiohttp' 'qt6-svg' 'qt6-webengine')
optdepends=('tts-biglinux: speech synthesis (BigLinux repository) — without it replies are shown only as text'
            'ollama: local AI engine (or point ChatToon to an Ollama server on your network)'
            'pipewire-audio: plays the voice on the desktop (pw-play); pulseaudio-utils or alsa-utils also work'
            'obs-studio: to show the avatar on your stream')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel' 'qt6-tools')

# the source is this repository, two levels up
_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  /usr/lib/qt6/bin/lrelease chattoon/i18n/chattoon_pt_BR.ts -qm chattoon/i18n/chattoon_pt_BR.qm
  /usr/bin/python -m build --wheel --no-isolation --outdir "$srcdir/dist"
  rm -rf build ./*.egg-info
}

package() {
  /usr/bin/python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 "$_root/data/chattoon.desktop" "$pkgdir/usr/share/applications/chattoon.desktop"
  install -Dm644 "$_root/data/chattoon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/chattoon.svg"
  install -Dm644 "$_root/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$_root/chattoon/web/vendor/three/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/three.js-LICENSE"
}
